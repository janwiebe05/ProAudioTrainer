{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProAudioTrainer",
  "version": "0.1.5",
  "identifier": "com.proaudiotrainer.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ProAudioTrainer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPLOCALDATA/library/**",
          "$APPCACHE/exercises/**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../frontend/EchoThief": "EchoThief"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/janwiebe05/ProAudioTrainer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzODU4NTEyNkUzNjM5OTAKUldTUU9UWnVFb1dGbzRNbFNPZ1l3ZTBjeUhFSlIyMHRZQmRxeW4xOFlCUEtyVzQ0VC91c2hwU3UK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
